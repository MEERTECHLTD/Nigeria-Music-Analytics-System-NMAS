# NMAS Month 1 / NBS delivery configuration

HOST=127.0.0.1
PORT=8000
ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///../data/nmas_delivery.db

# Exports and raw payload archive
EXPORT_ROOT=../data/exports
RAW_PAYLOAD_ROOT=../data/raw_payloads

# Chartmetric
CHARTMETRIC_BASE_URL=https://api.chartmetric.com
CHARTMETRIC_TOKEN_URL=https://api.chartmetric.com/api/token
CHARTMETRIC_AUTH_MODE=refresh
CHARTMETRIC_ACCESS_TOKEN=
CHARTMETRIC_REFRESH_TOKEN=your_chartmetric_refresh_token
CHARTMETRIC_CLIENT_ID=
CHARTMETRIC_CLIENT_SECRET=
CHARTMETRIC_TIMEOUT_SECONDS=30
CHARTMETRIC_THROTTLE_SECONDS=1.0
CHARTMETRIC_MAX_RETRIES=3
CHARTMETRIC_BACKOFF_SECONDS=2.0
CHARTMETRIC_VERIFY_SSL=true

# Logging
LOG_LEVEL=INFO
