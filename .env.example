# NMAS NBS Delivery Platform - Environment Template
# Copy to .env and fill in your values. NEVER commit .env to git.

# Server
HOST=127.0.0.1
PORT=8000
ENV=development
DEBUG=true

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/nmas_delivery.db
# DATABASE_URL=postgresql://user:password@host:5432/nmas_delivery

# Chartmetric API
CHARTMETRIC_AUTH_MODE=refresh
CHARTMETRIC_REFRESH_TOKEN=your_chartmetric_refresh_token
# CHARTMETRIC_THROTTLE_SECONDS=1.0
# CHARTMETRIC_MAX_RETRIES=3

# Export paths
EXPORT_ROOT=./data/exports
RAW_PAYLOAD_ROOT=./data/raw_payloads

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
