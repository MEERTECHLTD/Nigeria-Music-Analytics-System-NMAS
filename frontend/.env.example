# ── Live API ────────────────────────────────────────────────────────────────
# The FastAPI backend. When this answers /health, BOTH surfaces promote
# themselves to live automatically and begin polling — no code change is needed
# when the Chartmetric and SoundCharts endpoints are activated.
#
# Leave BLANK to pin everything to the generated static projection.
VITE_API_BASE=http://127.0.0.1:8000
VITE_API_TIMEOUT=30000

# ── Static projection ───────────────────────────────────────────────────────
# Output of backend/scripts/generate_console_api.py. Always the fallback, and
# the only transport that works on static hosting.
VITE_CONSOLE_API_BASE=/api/v1/console

# ── Auto-fetch cadence (milliseconds) ───────────────────────────────────────
# Only applies in live mode; the static projection is immutable between builds
# and is never polled.
VITE_LIVE_POLL_MS=60000
VITE_NBS_POLL_MS=60000
